{
  "name": "ng-select2-component",
  "version": "0.0.0",
  "description": "An Angular select2 component.",
  "author": "York Yao, Célian Veyssière",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ng-select2-component --configuration production && cp *.md dist/ng-select2-component",
    "build:demo": "ng build ng-select2 --configuration production",
    "publish:lib": "cd dist/ng-select2-component && npm publish --access public",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "lint": "ng lint ng-select2-component",
    "format": "prettier --write .",
    "e2e": "ng e2e",
    "reinstall": "npm run clean && npm i",
    "reinstall:all": "npm run clean && rm -f package-lock.json && npm i",
    "clean": "rm -rf ./dist/ ./.angular/ ./node_modules/ package-lock.json"
  },
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ikilote/json2html": "^1.0.0",
    "@jsverse/transloco": "^8.4.0",
    "bootstrap": "^5.3.9",
    "bowser": "2.15.0",
    "core-js": "^3.51.0",
    "graphemer": "^1.4.0",
    "highlight.js": "11.12.0",
    "ngx-highlightjs": "14.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@oxc-project/runtime": "^0.158.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.10.1",
    "prettier-plugin-css-order": "^2.2.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
